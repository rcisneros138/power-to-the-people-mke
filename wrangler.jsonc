{
  "name": "pttp",
  "compatibility_date": "2026-01-17",
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Client-review environment. Deployed from the `staging` branch to a separate
  // Worker so production is never touched. Routes are bound in the Cloudflare
  // dashboard as Custom Domains (same convention as prod — deliberately NOT
  // declared here, since dashboard-bound domains conflict with `routes`).
  "env": {
    "staging": {
      "name": "pttp-staging",
      // Reachable on workers.dev while there's no custom domain bound. The
      // build marks every non-production origin noindex + robots Disallow, so
      // it stays out of search, but the URL is public to anyone who has it.
      // Set back to false once a Custom Domain + Access policy front it.
      "workers_dev": true
    }
  }
}
